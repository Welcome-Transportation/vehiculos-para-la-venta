generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("NETLIFY_DB_URL")
}

// fleetStatus values: "ACTIVE_FLEET" | "PARKED"
model Listing {
  id                 String   @id @default(cuid())
  title              String
  price              Float
  description        String
  city               String
  county             String
  state              String   @default("FL")
  zipCode            String
  latitude           Float
  longitude          Float
  mileage            Int?
  isAdaAccessible    Boolean  @default(false)
  hasSeatBelts       Boolean  @default(false)
  hasTVs             Boolean  @default(false)
  hasPASystem        Boolean  @default(false)
  hasWorkingRadio    Boolean  @default(false)
  hasBluetooth       Boolean  @default(false)
  hasUSBPorts        Boolean  @default(false)
  hasWorkingBathroom Boolean  @default(false)
  isOperable         Boolean  @default(true)
  fleetStatus        String   @default("PARKED")
  isMigrated         Boolean  @default(false)
  createdAt          DateTime @default(now())
  sellerName         String?
  sellerPhone        String?
  sellerCompany      String?

  // Private admin-only fields for migrated listings: the original dealer's
  // posting URL and any contact info we could gather for it. Never rendered
  // on the public listing page - only surfaced on /admin so the site owner
  // can follow up and broker the sale.
  originalSourceUrl     String?
  originalSellerContact String?

  photos   Photo[]
  messages ContactMessage[]
}

model Photo {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}
